{
  "name": "fitpath-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local --persist-to .wrangler/state",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node script/smoke-test.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260728.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
