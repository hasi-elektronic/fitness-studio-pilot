{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitpath-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "production",
    "CORS_ORIGINS": "https://fitness-studio-pilot.pages.dev,http://localhost:5173,http://127.0.0.1:5173"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitpath-db",
      "database_id": "0cac4cb7-b6ba-4cb3-ad37-77a1c8e16d9f",
      "migrations_dir": "migrations"
    }
  ]
}
